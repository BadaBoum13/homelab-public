apiVersion: operator.victoriametrics.com/v1
kind: VLAgent
metadata:
  name: vlagent
  namespace: monitoring
spec:
  remoteWrite:
    - url: http://vlsingle-vl-single.monitoring.svc.cluster.local:9428/insert/logs
  # scrapeConfigs:
